{
  "name": "clinsight-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@clinsight/web",
    "dev:doctor": "turbo dev --filter=@clinsight/doctor",
    "dev:user": "turbo dev --filter=@clinsight/user",
    "dev:admin": "turbo dev --filter=@clinsight/admin",
    "build": "turbo build",
    "build:web": "turbo build --filter=@clinsight/web",
    "build:doctor": "turbo build --filter=@clinsight/doctor",
    "build:user": "turbo build --filter=@clinsight/user",
    "build:admin": "turbo build --filter=@clinsight/admin",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mjs,cjs}": "prettier --write"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.8.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
